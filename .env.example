# ══════════════════════════════════════════════════════
#  BOT DELTA-NEUTRAL — VARIABLES DE ENTORNO
#  Copia este archivo como .env y rellena los valores
#  NUNCA subas .env a git
# ══════════════════════════════════════════════════════

# ── MODO DE OPERACION ─────────────────────────────────
# EMPIEZA SIEMPRE EN true. Cambia a false solo cuando
# hayas verificado el sistema funciona durante 24h+
DRY_RUN=true
USE_MOCK_DATA=false

# ── NADO FINANCE — Ink Network (Rabby Wallet) ─────────
# Clave privada de tu wallet en Ink Network
# Formato hex con 0x: 0xabcdef1234...
# NUNCA compartas esta clave con nadie
NADO_PRIVATE_KEY=0x_TU_CLAVE_PRIVADA_INK_AQUI

# ── 01 EXCHANGE — Solana (Phantom Wallet) ─────────────
# URL de la API REST LOCAL de 01 Exchange (corre en tu maquina)
# Instrucciones: https://github.com/01protocol/zo-ts-rest-api
EXCHANGE_01_URL=http://localhost:3000

# Clave privada de tu wallet Phantom en Solana
# Formato base58 o array JSON de bytes
EXCHANGE_01_PRIVATE_KEY=TU_CLAVE_PRIVADA_SOLANA_BASE58

# ── TELEGRAM ──────────────────────────────────────────
# 1. Crea un bot en @BotFather -> te da el token
# 2. Envia /start a @userinfobot -> te da tu chat_id
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI-jklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# ── GESTION DE RIESGO (calibrado para < $1,000) ───────
MAX_POSITION_USD=500
MIN_POSITION_USD=150
MAX_LEVERAGE=2.0
MAX_OPEN_POSITIONS=2
MIN_NET_APR_PCT=35.0
MAX_SPREAD_PCT=0.06
STOP_LOSS_PCT=3.0
LIQ_BUFFER_PCT=35.0
MAX_BREAKEVEN_HOURS=96.0
MAX_AGE_HOURS=120.0

# ── DASHBOARD ─────────────────────────────────────────
DASHBOARD_PORT=8080
DASHBOARD_WS_PORT=8081

# ── OPERACIONAL ───────────────────────────────────────
MONITOR_INTERVAL=30
MIN_OPPORTUNITY_SCORE=70.0
